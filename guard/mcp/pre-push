#!/bin/sh
# Installed by Guard. Before a push, your coding agent reviews the pushed commits with Guard.
# A P0 finding stops the push. When the review does not finish, the push goes on.
#
# Skip the review once:  GUARD_SKIP=1 git push
# Choose the agent:      git config guard.agent claude   (or codex, or pi)
# Remove the hook:       rm "$(git rev-parse --git-path hooks)/pre-push"
# Update it:             ask your agent to install the Guard pre-push hook again.
#
# The agent gets no shell: the hook sends the diff itself. The agent calls the Guard tools and reads
# files only, because the review shows it text from the repository and from GitHub.

[ "${GUARD_SKIP:-}" = 1 ] && exit 0

SITE="__GUARD_SITE__"
# Seconds. A hung agent or a sign-in that waits must not hold the push.
START_TIMEOUT=${GUARD_START_TIMEOUT:-180}
REVIEW_TIMEOUT=${GUARD_TIMEOUT:-900}
# The remote branches, most recent first, that can be the base of a new branch. A base branch such as a
# release or hotfix branch gets commits. Each one costs a `git rev-list --count <branch>..<commit>`,
# which walks the branch back to the merge base, also with --max-count: a branch that split off long
# ago costs the most.
MAX_BRANCHES=30

say() { printf 'guard: %s\n' "$*" >&2; }
# Agent output without control characters, so it cannot move the cursor or change the terminal.
clean() { LC_ALL=C tr -d '\000-\010\013-\037\177'; }

# Git sends one line for each pushed ref. Review the last branch that is not deleted.
head="" branch="" target="" old="" skipped=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case $local_ref in refs/heads/*) ;; *) continue ;; esac
	# A deleted ref has a sha of zeros.
	case $local_sha in *[!0]*) ;; *) continue ;; esac
	[ -n "$head" ] && skipped=$((skipped + 1))
	head=$local_sha
	branch=${local_ref#refs/heads/}
	target=${remote_ref#refs/heads/}
	old=$remote_sha
done
[ -n "$head" ] || exit 0
[ "$skipped" -gt 0 ] && say "this push has more branches. Guard reviews only $branch."

# A push that adds commits to a branch of the remote: the base is the old commit of that branch, so the
# review has the pushed commits only. This is so for every branch, also the default branch after a merge
# of a release branch. A new branch has an old commit of zeros. After a force push the old commit is not
# an ancestor, or git does not have it: then the hook picks the base after the start.
base=""
case $old in *[!0]*)
	git merge-base --is-ancestor "$old" "$head" 2>/dev/null && base=$old
	;;
esac
if [ "$base" = "$head" ]; then
	say "nothing new to review in $branch, so the push goes on."
	exit 0
fi

agent=$(git config guard.agent || :)
if [ -z "$agent" ]; then
	for candidate in claude codex pi; do
		if command -v "$candidate" >/dev/null 2>&1; then
			agent=$candidate
			break
		fi
	done
fi
if [ -z "$agent" ] || ! command -v "$agent" >/dev/null 2>&1; then
	say "found no coding agent (claude, codex or pi), so the push goes on without a review."
	exit 0
fi
case $agent in claude | codex | pi) ;; *)
	say "guard.agent is $agent. Use claude, codex or pi."
	exit 0
	;;
esac

limit=$(command -v timeout || command -v gtimeout || :)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Run the agent with the Guard tools and, for the review, the tools that read files. No shell, no
# edits and no web.
ask_agent() { # seconds, read files (yes or no), prompt
	seconds=$1 reads=$2 prompt=$3
	set --
	[ -n "$limit" ] && set -- "$limit" "$seconds"
	case $agent in
	claude)
		allowed=mcp__guard
		[ "$reads" = yes ] && allowed="mcp__guard,Read,Grep,Glob"
		"$@" claude -p "$prompt" --permission-mode dontAsk --allowedTools "$allowed" \
			--disallowedTools "Bash,Edit,Write,NotebookEdit,WebFetch,WebSearch,Task"
		;;
	codex)
		# A read-only sandbox without network: shell commands can read, and change nothing.
		"$@" codex exec --sandbox read-only "$prompt"
		;;
	pi)
		tools='mcp__guard__*'
		[ "$reads" = yes ] && tools="read,grep,find,ls,$tools"
		"$@" pi -p --tools "$tools" "$prompt"
		;;
	esac
}

value() { sed -n "s/.*$1=\([^ \`]*\).*/\1/p" "$2" | tail -n 1; }

say "$agent reviews the push of $branch. It takes some minutes. To skip it: GUARD_SKIP=1 git push"
# The remote that Guard reviews is origin. A clone of a fork can have no origin: then it is upstream,
# and without both, the remote of this push. Not upstream first: in a fork of a company, upstream is
# another repository that Guard can also review.
remote=${1:-origin}
for candidate in origin upstream; do
	if git remote get-url "$candidate" >/dev/null 2>&1; then
		remote=$candidate
		break
	fi
done
repository=$(git remote get-url "$remote" 2>/dev/null || printf '%s' "${2:-}")
ask_agent "$START_TIMEOUT" no "Call the Guard tool start_review with repository $repository. Do not call \
other tools. Then print these three lines, with the values from its answer, and nothing else:
GUARD_REVIEW=<review_id>
GUARD_SECRET=<upload.secret>
GUARD_BRANCH=<upload.base_branch>" </dev/null >"$work/start" 2>&1

review=$(value GUARD_REVIEW "$work/start")
secret=$(value GUARD_SECRET "$work/start")
base_branch=$(value GUARD_BRANCH "$work/start")
# The values go into a URL and git commands: take only the shapes that Guard sends.
if ! printf '%s' "$review" | grep -Eqx '[0-9a-f]{16}' ||
	! printf '%s' "$secret" | grep -Eqx '[0-9a-f]{32}' ||
	! printf '%s' "$base_branch" | grep -Eqx '[A-Za-z0-9._/-]{1,140}'; then
	tail -n 20 "$work/start" | clean >&2
	say "the agent did not start a Guard review, so the push goes on. Is it signed in to Guard?"
	exit 0
fi

# Guard sent the default branch. The base branch is a name for Guard: the hook sends the base commit.
default_branch=$base_branch
if [ -n "$base" ]; then
	# The pushed commits on a branch of the remote. Its name, when Guard takes it.
	base_branch=$target
	case $base_branch in '' | *[!A-Za-z0-9._/-]*) base_branch=$default_branch ;; esac
	[ "${#base_branch}" -le 140 ] || base_branch=$default_branch
	say "the base is the commit of $target on the remote, so Guard reviews the pushed commits."
else
	# A new branch, or a force push. The base is the branch of the remote with the nearest merge base:
	# the fewest commits from it to the pushed commit. So a branch from a release or hotfix branch sends
	# only its own commits. On a tie, the default branch wins. Another branch with no commits to the
	# pushed commit does not count: it has the commit already, and the diff would be empty. The
	# branch that this push updates does not count either: after a force push, its old commit is not
	# the base.
	best=$(git rev-list --count "refs/remotes/$remote/$default_branch..$head" 2>/dev/null || :)
	pushed_here=no
	if [ "${1:-}" = "$remote" ] || { [ -n "${2:-}" ] && [ "$2" = "$(git remote get-url "$remote" 2>/dev/null)" ]; }; then
		pushed_here=yes
	fi
	for ref in $(git for-each-ref --sort=-committerdate --count="$MAX_BRANCHES" --format='%(refname)' \
		"refs/remotes/$remote/"); do
		[ "$best" = 0 ] && break
		name=${ref#refs/remotes/"$remote"/}
		case $name in HEAD | "$default_branch") continue ;; esac
		[ "$pushed_here" = yes ] && [ "$name" = "$target" ] && continue
		# Guard takes only these names, as in the upload command.
		case $name in *[!A-Za-z0-9._/-]*) continue ;; esac
		[ "${#name}" -le 140 ] || continue
		# Commits of the pushed commit that are not on the branch: the commits from the merge base.
		# Count only up to the best so far: a higher count cannot win.
		if [ -n "$best" ]; then
			count=$(git rev-list --count --max-count="$best" "$ref..$head" 2>/dev/null) || continue
		else
			count=$(git rev-list --count "$ref..$head" 2>/dev/null) || continue
		fi
		[ "$count" = 0 ] && continue
		if [ -z "$best" ] || [ "$count" -lt "$best" ]; then
			best=$count
			base_branch=$name
		fi
	done
	[ "$base_branch" = "$default_branch" ] ||
		say "the base is $remote/$base_branch, the remote branch nearest to $branch."
	if ! base=$(git merge-base "$head" "refs/remotes/$remote/$base_branch" 2>/dev/null); then
		say "found no merge base with $remote/$base_branch, so the push goes on. Run: git fetch $remote"
		exit 0
	fi
fi
if [ "$base" = "$head" ]; then
	say "nothing new to review in $branch, so the push goes on."
	exit 0
fi
if ! git diff --binary "$base" "$head" >"$work/diff"; then
	say "git could not make the diff of $branch, so the push goes on."
	exit 0
fi
if ! curl -sS --fail-with-body -X POST -H 'Content-Type: application/octet-stream' \
	-H "X-Guard-Upload: $secret" -H "X-Guard-Base: $base" -H "X-Guard-Head: $head" \
	-H "X-Guard-Branch: $branch" -H "X-Guard-Base-Branch: $base_branch" \
	--data-binary @"$work/diff" "$SITE/mcp/upload/$review" \
	>"$work/upload" 2>&1; then
	clean <"$work/upload" >&2
	say "Guard did not take the diff, so the push goes on."
	exit 0
fi

ask_agent "$REVIEW_TIMEOUT" yes "Review the commits that I push, with Guard. The diff is sent: call the Guard tool review_context with review_id $review, \
review the change as its guide says, and call submit_review with review_id $review. Do not change files. \
End your answer with these two lines, with the values from the answer of submit_review:
GUARD_P0=<p0>
GUARD_URL=<url>" </dev/null >"$work/review" 2>&1

p0=$(sed -n 's/.*GUARD_P0=\([0-9][0-9]*\).*/\1/p' "$work/review" | tail -n 1)
url=$(value GUARD_URL "$work/review" | clean)
if [ -z "$p0" ]; then
	tail -n 20 "$work/review" | clean >&2
	say "the review did not finish, so the push goes on."
	exit 0
fi
if [ "$p0" -gt 0 ]; then
	sed '/GUARD_P0=/d; /GUARD_URL=/d' "$work/review" | clean >&2
	say "push stopped: $p0 P0 findings. $url"
	say "fix them, or push anyway with: GUARD_SKIP=1 git push"
	exit 1
fi
say "no P0 findings. $url"
exit 0
